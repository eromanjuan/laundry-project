rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public username → email lookup (needed before sign-in for username login).
    // Contains only { email }, no sensitive data.
    match /usernames/{name} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Business settings (logo, pricing, receipt info) — readable so the login
    // screen can show branding; only signed-in users can change them.
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public order tracking — only { id, status, updatedAt } (no PII). Read by
    // customers scanning the QR on their receipt; written by signed-in staff.
    match /tracking/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // GCash proof-of-payment images uploaded by customers from the tracking page.
    // Anyone may create a validated, size-capped proof; only signed-in staff can
    // read them (to verify) or update/delete (to mark reviewed / clear).
    match /paymentProofs/{id} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.jobKey is string
        && request.resource.data.image is string
        && request.resource.data.image.size() < 1000000;
      allow update, delete: if request.auth != null;
    }

    // Push-notification subscriptions written by customers (unauthenticated) from
    // the tracking page. Never publicly readable (endpoints are semi-sensitive);
    // the push-sync GitHub Action reads/deletes them via the admin SDK. Writes are
    // shape-validated to limit abuse; deletes from clients are blocked.
    match /pushSubs/{id} {
      allow read: if false;
      allow create, update: if request.resource.data.jobKey is string
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() < 2000
        && request.resource.data.keys is map;
      allow delete: if false;
    }

    // Everything else (customers, orders, payments, users, etc.):
    // signed-in users only. This closes the public read/write hole.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
