# Firebase Web App configuration for the "laundryprojectpos" project.
# Copy this file to `.env`, then paste the values from:
#   Firebase Console → Project settings → Your apps → Web app → SDK setup & config
#
# `.env` is git-ignored, so your keys stay local.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
